VITE_API_BASE_URL=http://localhost:5000

# Map Tile Provider URL
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Allow prefetching of map tiles for offline caching. 
# OpenStreetMap STRICTLY PROHIBITS bulk downloading/prefetching.
# Set to 'true' only if using a custom tile server that permits it.
# VITE_ALLOW_PREFETCH=false
